# AI provider: "gemini" (free, cloud), "ollama" (free, local) or "claude" (paid). Defaults to gemini.
AI_PROVIDER=gemini

# Local AI with Ollama (FREE, no key, no limits, runs on your PC): https://ollama.com
# then run once:  ollama pull qwen3:4b
# AI_PROVIDER=ollama uses it for everything; AI_FALLBACK=ollama uses it only when Gemini is busy or out of quota.
AI_FALLBACK=ollama
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_HOST=http://127.0.0.1:11434

# Gemini (FREE, no credit card): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-3.8-flash
# Used in order when the main model is overloaded or out of free quota:
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-flash-lite-latest

# Web search for the salary feature (FREE, no card, 1,000 searches/month): https://app.tavily.com
# Without it, salary figures are an AI estimate with links to check.
TAVILY_API_KEY=

# Claude (paid, optional): https://platform.claude.com/settings/keys, then set AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# France Travail (official, FREE, no monthly limit): create an account on https://francetravail.io,
# "Mes applications" > create an app > subscribe it to the API "Offres d'emploi", then copy its ID and secret.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Bundesagentur für Arbeit (Germany) needs no key.

# LinkedIn / Indeed / Glassdoor offers via JSearch (FREE plan, ~100 requests/month):
# sign up at https://rapidapi.com, subscribe to the Basic plan of
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch and copy your X-RapidAPI-Key here.
RAPIDAPI_KEY=

# Optional: free key at https://developer.adzuna.com (adds offers from ~18 countries)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Port for `npm run dev` (default 3000)
# PORT=3001
